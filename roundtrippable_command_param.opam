opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/roundtrippable_command_param"
bug-reports: "https://github.com/public-release-reloaded/roundtrippable_command_param/issues"
dev-repo: "git+https://github.com/public-release-reloaded/roundtrippable_command_param.git#v0.18_preview.130.106+341+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/roundtrippable_command_param/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "core_kernel" {>= "v0.18~" & < "v0.19~"}
  "file_path" {>= "v0.18~" & < "v0.19~"}
  "ppx_bench" {>= "v0.18~" & < "v0.19~"}
  "ppx_expect" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_module_timer" {>= "v0.18~" & < "v0.19~"}
  "ppxlib_jane" {>= "v0.18~" & < "v0.19~"}
  "profunctor" {>= "v0.18~" & < "v0.19~"}
  "univ_map" {>= "v0.18~" & < "v0.19~"}
  "variantslib" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ppxlib" {> "0.38.0"}
]
available: arch != "x86_32"
synopsis: "A library for building Command.Param.t values that can roundtrip to command-line arguments"
description: "
Roundtrippable_command_param provides utilities for creating Command.Param.t values that can be converted back to command-line arguments, enabling serialization of command parameters.
"
